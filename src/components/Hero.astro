---
const { height = "72vh" } = Astro.props;
---

<section class="hero" style={`min-height: ${height}`}>

  <!-- Background photo lives at /public/hero.jpg (see note below).
       Navy overlay keeps the light text legible over any image. -->
  <div class="hero-bg"></div>
  <div class="hero-overlay"></div>

  <div class="container hero-content">
    <!-- <p class="eyebrow eyebrow-light">Construction productivity intelligence</p> -->
    <p class="eyebrow eyebrow-light">Measure. Benchmark. Improve.</p>
    <h1>Building the future of construction<br class="lb" /> with data&#8209;driven intelligence</h1>
    <p class="sub">
    Camentis unlocks the value of construction data, 
    transforming fragmented project information into near real-time 
    intelligence that <span class="accent">improves productivity</span>, 
    enables <span class="accent">proactive decision-making</span>, and 
      drives <span class="accent">cross-project learning,
    </span>helping teams deliver better outcomes with greater certainty.


      <!-- Camentis integrates fragmented site data, including
      <span class="accent">labour, delivery, IoT, progress, and visual capture</span>,
      into one consistent, near-real-time view of productivity. -->
      <br>
      <!-- <br><b><span class="accent">Measure. Benchmark. Improve.</span></b> -->
    </p>
    <div class="cta-row">
      <!-- <a href="https://app.camentis.ai" target="_blank" rel="noopener" class="btn btn-primary">
        Open platform ↗
      </a> -->
      <a href="#contact" class="btn btn-outline">BOOK A DEMO</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    color: var(--white);
    background: var(--navy); /* fallback before the image loads / if absent */
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url("/hero.jpg");
    background-size: cover;
    background-position: center;
  }

  /* Navy wash: darker on the left where the text sits, lighter on the
     right so the image still reads. Keeps the heading legible. */
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(
      90deg,
      rgba(0, 23, 57, 0.92) 0%,
      rgba(0, 38, 87, 0.75) 45%,
      rgba(0, 38, 87, 0.45) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding: 90px 32px;
    max-width: 780px;
  }

  .eyebrow-light { color: var(--sky); }

  .hero h1 {
    color: var(--white);
    font-size: 52px;
    font-weight: 800;
    line-height: 1.12;
    margin-bottom: 26px;
  }

  .hero .sub {
    font-size: 18px;
    line-height: 1.7;
    color: var(--cool-grey);
    max-width: 600px;
    margin-bottom: 36px;
  }

  .hero .sub .accent {
    color: var(--yellow);
  }

  .cta-row {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .hero h1 { font-size: 36px; }
    .hero .sub { font-size: 16px; }
    .lb { display: none; }
  }
</style>
