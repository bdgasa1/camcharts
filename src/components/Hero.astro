---
const { height = "72vh" } = Astro.props;
---

<section class="hero" style={`min-height: ${height}`}>

  <!-- Background photo: save as /public/hero.jpg (JPEG, RGB colour mode,
       ~2400px wide, under ~400KB). Focal point is set in .hero-bg below.
       Shown at its true colours, with no tint or overlay. -->
  <div class="hero-bg"></div>

  <div class="container hero-content">
    <p class="eyebrow eyebrow-light">Construction productivity intelligence</p>
    <h1>Building the future of construction<br class="lb" /> with data&#8209;driven intelligence</h1>
    <p class="sub">
      Camentis integrates fragmented site data, including
      <span class="accent">labour, delivery, IoT, progress, and visual capture</span>,
      into one consistent, near-real-time view of productivity.
      Measure. Benchmark. Improve.
    </p>
    <div class="cta-row">
      <a href="https://app.camentis.ai" target="_blank" rel="noopener" class="btn btn-primary">
        Open platform ↗
      </a>
      <a href="#contact" class="btn btn-outline">Get in touch</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    color: var(--white);
    background: var(--navy); /* fallback before the image loads / if absent */
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url("/hero.jpg");
    background-size: cover;
    /* Focal point: "x y". e.g. "70% center" keeps the right side of the
       photo in view on narrow screens; "center top" keeps the top. */
    background-position: center;
  }

  /* No overlay: the photo is shown exactly as colour-corrected.
     If text legibility ever needs help over a bright area, add
     <div class="hero-overlay"></div> after .hero-bg and uncomment this
     neutral (non-blue) scrim, which darkens without shifting colour:

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(90deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0) 70%);
  }
  */

  .hero-content {
    position: relative;
    z-index: 1;
    padding: 90px 32px;
    max-width: 780px;
  }

  .eyebrow-light { color: var(--sky); }

  .hero h1 {
    color: var(--white);
    font-size: 52px;
    font-weight: 800;
    line-height: 1.12;
    margin-bottom: 26px;
  }

  .hero .sub {
    font-size: 18px;
    line-height: 1.7;
    color: var(--cool-grey);
    max-width: 600px;
    margin-bottom: 36px;
  }

  .hero .sub .accent {
    color: var(--yellow);
  }

  .cta-row {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .hero h1 { font-size: 36px; }
    .hero .sub { font-size: 16px; }
    .lb { display: none; }
  }
</style>
