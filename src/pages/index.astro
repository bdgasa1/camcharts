---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
---

<BaseLayout>

  <!-- Rebrand notice: shown only to visitors arriving via the old camconiq.com domain -->
  <div id="rebrand-banner" class="migration-banner" style="display: none;">
    CamConIQ is now Camentis. Our new home is
    <a href="https://camentis.ai">camentis.ai</a>
  </div>
  <script is:inline>
    if (window.location.hostname.endsWith("camconiq.com")) {
      var b = document.getElementById("rebrand-banner");
      if (b) b.style.display = "block";
    }
  </script>

  <Header />

  <main>

    <Hero height="74vh" />

    <!-- ═══════════════════════════════════════
         WHAT WE DO (hexagon-framed flowline visual)
    ══════════════════════════════════════════ -->
    <section class="platform" id="platform">
      <div class="container split">

        <div class="split-copy">
          <p class="eyebrow">Our Platform</p>
          <h2>One consistent view of productivity</h2>
          <p>
            Multi-source construction data exists on every project, but it
            sits in disconnected silos: planning tools, site diaries,
            delivery records, and visual capture systems, with no
            integration layer connecting them. By the time a slowdown
            appears in the weekly report, the window to intervene has
            closed.
          </p>
          <p>
            Camentis connects those streams into one standardised view:
            planned vs actual comparisons, production rates, flowlines,
            and variability indicators, updated in near real-time rather
            than after the fact.
          </p>
          <a href="https://app.camentis.ai" target="_blank" rel="noopener" class="link-arrow">
            See the platform ↗
          </a>
        </div>

        <div class="split-visual">
          <div class="hex-frame">
            <svg viewBox="0 0 300 300" class="flowline-art" role="img" aria-label="Flowline diagram illustrating planned versus actual construction progress">
              <rect width="300" height="300" fill="#EFF1F2" />
              <!-- planned lines -->
              <line x1="20" y1="240" x2="280" y2="60" stroke="#DADFE2" stroke-width="3" />
              <line x1="20" y1="270" x2="280" y2="110" stroke="#DADFE2" stroke-width="3" />
              <!-- actual, with a stall + recovery kink -->
              <polyline points="20,220 110,150 150,150 150,120 280,40" fill="none" stroke="#00A4B1" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
              <polyline points="20,255 130,175 168,175 168,150 280,95" fill="none" stroke="#002657" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
              <circle cx="150" cy="150" r="6" fill="#E5E798" stroke="#002657" stroke-width="1.5" />
            </svg>
          </div>
        </div>

      </div>
    </section>

    <!-- ═══════════════════════════════════════
         RESEARCH FOUNDATION (dark panel, ring gauge)
    ══════════════════════════════════════════ -->
    <section class="research">
      <div class="container research-body">

        <div class="split-copy" id="about">
          <p class="eyebrow">Research foundation</p>
          <h2 class="light">Five years of empirical research at the University of Cambridge</h2>
          <p class="light-body">
            Camentis was developed and validated through pilot projects with clients, Tier 1 and Tier 2 contractors.
            The approach has been tested across 25+ projects in collaboration 
            with leading UK construction organisations, including Laing O’Rourke,
             Landsec, Morrisroe, Mace, Sir Robert McAlpine and Skanska.
          </p>
          <p class="light-body">
            This work has received significant industry recognition, 
            including two wins at the 2026 Industrialised Construction Awards 
            (Best Collaborative Project and the overall Winner of Winners) 
            as well as a shortlisting for Digital Innovation.
          </p>
          <p class="light-body">
            With the core technology now developed and extensively validated, 
            Camentis is actively engaging with customers and industry 
            partners to deploy the platform through live pilots.
          </p>
        </div>

      </div>
    </section>

    <!-- ═══════════════════════════════════════
         FOUNDERS
    ══════════════════════════════════════════ -->
    <section class="founders">
      <div class="container">
        <h2 class="section-heading">Meet the team</h2>
        <div class="founders-grid">

          <div class="founder-card">
            <div class="founder-head">
              <div class="avatar-hex-wrap">
                <svg class="avatar-accent" viewBox="0 0 600 693" aria-hidden="true">
                  <polygon points="300,0 600,173.25 600,519.75 300,693 0,519.75 0,173.25" />
                </svg>
                <img src="/ashan.png" alt="Dr Ashan Asmone" class="avatar-photo" />
              </div>
              <div class="founder-id">
                <h3>Dr Ashan Asmone</h3>
                <span class="role">Research Associate, University of
                  Cambridge</span>
              </div>
            </div>
            <p>
              Fifteen years across construction delivery, facilities management, and academia. 
              Now researching construction productivity at Cambridge, 
              combining the continuous improvement discipline of manufacturing 
              with data-driven innovation to develop new ways of measuring and improving project performance.
              
            </p>
            <a
              href="https://www.linkedin.com/in/ashan-asmone/"
              target="_blank"
              rel="noopener"
              class="linkedin-link"
            >
              LinkedIn ↗
            </a>
          </div>

          <div class="founder-card">
            <div class="founder-head">
              <div class="avatar-hex-wrap">
                <svg class="avatar-accent" viewBox="0 0 600 693" aria-hidden="true">
                  <polygon points="300,0 600,173.25 600,519.75 300,693 0,519.75 0,173.25" />
                </svg>
                <img src="/danny.png" alt="Dr Danny Murguia" class="avatar-photo" />
              </div>
              <div class="founder-id">
                <h3>Dr Danny Murguia</h3>
                <span class="role">Assistant Research Professor, University of
                  Cambridge</span>
              </div>
            </div>
            <p>
              Twenty years of construction engineering experience. Leads a research programme focused on developing novel methods to enhance the performance and productivity of major building and infrastructure projects through digital techniques, automation, and Artificial Intelligence.
            </p>
            <a
              href="https://www.linkedin.com/in/dannymurguia/"
              target="_blank"
              rel="noopener"
              class="linkedin-link"
            >
              LinkedIn ↗
            </a>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════
         CONTACT
    ══════════════════════════════════════════ -->
    <section class="contact" id="contact">
      <div class="container contact-grid">

        <div class="contact-intro">
          <p class="eyebrow">Contact</p>
          <h2>Become a pilot partner</h2>
          <p>
            <!-- We are now onboarding pilot partners for 2027.  -->
            If you are an organisation in the building or infrastructure sector 
            looking to gain a clearer, more consistent view of 
            productivity across your projects, we would like to hear from you. 
            </p>
            <p>
            <b>Partner with us to put data-driven productivity measurement into practice.</b>
            </p>
          <!--
          <a href="mailto:info@camconiq.com" class="email-link">
            info@camconiq.com
          </a>
          -->
        </div>

        <!--
          FORM: uses Formspree for static-site email delivery.
          Endpoint connected: https://formspree.io/f/xkoleynp
        -->
        <form
          class="contact-form"
          action="https://formspree.io/f/xkoleynp"
          method="POST"
        >
          <input type="text" name="name" placeholder="Name" required />
          <input type="email" name="email" placeholder="Email" required />
          <textarea name="message" placeholder="Message" rows="5" required></textarea>
          <button type="submit" class="btn btn-primary">Send message</button>
        </form>

      </div>
    </section>

  </main>

  <Footer />

</BaseLayout>

<style>
  /* ─── MIGRATION BANNER ───────────────────── */
  .migration-banner {
    background: var(--light-grey);
    border-bottom: 1px solid var(--cool-grey);
    text-align: center;
    padding: 9px 24px;
    font-size: 13px;
    color: var(--slate);
    font-family: var(--font-body);
  }
  .migration-banner a {
    color: var(--teal-dark);
    font-weight: 600;
    text-decoration: none;
  }
  .migration-banner a:hover { text-decoration: underline; }

  /* ─── SPLIT LAYOUT (shared: platform + research) ─ */
  .split {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 64px;
    align-items: center;
  }

  .platform {
    padding: var(--section-pad) 0;
    background: var(--white);
  }

  .split-copy h2 {
    font-size: 38px;
    font-weight: 800;
    margin-bottom: 22px;
  }

  .split-copy p {
    font-size: 17px;
    line-height: 1.75;
    color: var(--slate);
    margin-bottom: 18px;
  }

  .link-arrow {
    display: inline-block;
    margin-top: 6px;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--teal-dark);
  }
  .link-arrow:hover { color: var(--navy); }

  .hex-frame {
    aspect-ratio: 1.05 / 1;
    clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);
    background: var(--light-grey);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .flowline-art { width: 100%; height: 100%; }

  /* ─── RESEARCH (dark panel) ──────────────── */
  .research {
    padding: var(--section-pad) 0;
    background: var(--navy);
  }

  .research .light { color: var(--white); }
  .research .light-body { color: var(--cool-grey); }
  .research .eyebrow { color: var(--sky); }

  .research-body {
    max-width: 700px;
  }

  /* ─── FOUNDERS ───────────────────────────── */
  .founders {
    background: var(--light-grey);
    padding: var(--section-pad) 0;
  }

  .section-heading {
    font-size: 34px;
    font-weight: 800;
    margin: 0 0 44px 0;
  }

  .founders-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }

  .founder-card {
    background: var(--white);
    border: 1px solid var(--cool-grey);
    border-radius: 6px;
    padding: 36px 34px;
    display: flex;
    flex-direction: column;
  }

  .founder-card h3 {
    font-size: 21px;
    font-weight: 700;
    margin: 0 0 6px 0;
  }

  .role {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 600;
    color: var(--teal-dark);
    text-transform: uppercase;
    letter-spacing: 0.09em;
  }

  .founder-card p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--slate);
    margin-bottom: 12px;
    flex-grow: 1;
  }

  .linkedin-link {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    color: var(--navy);
    margin-top: 12px;
    transition: color 0.2s;
  }
  .linkedin-link:hover { color: var(--teal-dark); }

  /* ─── FOUNDER HEAD (avatar above centred name/role) ──── */
  .founder-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 22px;
  }

  .avatar-hex-wrap {
    position: relative;
    width: 240px;
    height: 313px;   /* matches the pre-cropped PNGs' 600:693 ratio exactly */
    flex-shrink: 0;
    margin-bottom: 18px;
  }

  /* Subtle offset teal accent, matching the logo's actual pointy-top
     hexagon orientation (point at top/bottom, flat left/right sides) */
  .avatar-accent {
    position: absolute;
    inset: 0;
    transform: translate(11px, 11px);
  }

  .avatar-accent polygon {
    fill: var(--teal);
    opacity: 0.32;
  }

  /* Image is already cropped to a hexagon (transparent PNG) — display
     as-is, no second clip-path, so its shape is never re-cut */
  .avatar-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .founder-id { min-width: 0; }
  .founder-id h3 { margin-bottom: 6px; }
  .founder-id .role { margin-bottom: 0; }

  /* ─── CONTACT ────────────────────────────── */
  .contact {
    padding: var(--section-pad) 0;
    background: var(--white);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    align-items: start;
  }

  .contact-intro h2 {
    font-size: 34px;
    font-weight: 800;
    margin: 0 0 20px 0;
  }

  .contact-intro p {
    font-size: 16px;
    line-height: 1.75;
    color: var(--slate);
    margin-bottom: 20px;
  }

  .email-link {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    color: var(--teal-dark);
  }
  .email-link:hover { text-decoration: underline; }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    padding: 13px 16px;
    border: 1px solid var(--cool-grey);
    border-radius: 4px;
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--slate);
    box-sizing: border-box;
    background: var(--white);
    transition: border-color 0.2s;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: none;
    border-color: var(--teal);
  }

  .contact-form textarea { resize: vertical; }
  .contact-form .btn { align-self: flex-start; margin-top: 4px; }

  /* ─── RESPONSIVE ─────────────────────────── */
  @media (max-width: 960px) {
    .founders-grid { grid-template-columns: 1fr; }
    .contact-grid  { grid-template-columns: 1fr; gap: 48px; }
    .split {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .hex-frame { max-width: 340px; margin: 0 auto; }
  }

  @media (max-width: 420px) {
    .avatar-hex-wrap { width: 124px; height: 143px; }
  }
</style>